# Copy this file to .env and fill in your own values. Never commit .env.
SECRET_KEY=change-this-to-a-long-random-string

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=frigdex

# Contact details shown on the website. Anything left empty is simply not shown.
# WhatsApp number: digits only, with country code (India example: 919XXXXXXXXX)
WHATSAPP_NUMBER=
# Phone number exactly as visitors should see it, for example: +91 98XXX XXXXX
SITE_PHONE=
SITE_EMAIL=
GST_NUMBER=

FLASK_DEBUG=0
# Set to true on Render so session cookies are marked secure
RENDER=false
